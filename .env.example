# Salin file ini jadi .env lalu isi nilainya. JANGAN commit .env ke GitHub.

# Firebase: dari file JSON service account (project_id, client_email, private_key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Admin: JWT_SECRET dibuat dengan
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_PASSWORD=

PORT=3000
ALLOWED_ORIGINS=https://domain-kamu.vercel.app
TIMECAPSULE_UNLOCK=2029-09-09T00:00:00+08:00
